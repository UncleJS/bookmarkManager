{
  "manifest_version": 3,
  "name": "Bookmark Capture",
  "version": "2.3",
  "description": "Capture bookmarks to a local API",
  "action": { "default_popup": "popup/popup.html", "default_icon": {"16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png"} },
  "background": { "service_worker": "background/background.js", "type": "module" },
  "permissions": ["tabs", "activeTab", "contextMenus", "storage", "notifications", "scripting"],
  "host_permissions": ["http://localhost:11650/*"],
  "options_page": "options/options.html",
  "icons": { "16": "assets/icons/icon16.png", "32": "assets/icons/icon32.png", "48": "assets/icons/icon48.png", "128": "assets/icons/icon128.png" },
  "web_accessible_resources": [{ "resources": ["assets/icons/icon48.png"], "matches": ["<all_urls>"] }]
}
