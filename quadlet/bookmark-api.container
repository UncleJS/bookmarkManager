# =============================================================================
# Bookmark Manager Production API — Quadlet unit file
# Installs to: ~/.config/containers/systemd/bookmark-api.container
# Bun/Elysia API — built from api/Dockerfile.
# =============================================================================

[Unit]
Description=Bookmark Manager production API (Bun/Elysia)
PartOf=bookmark-pod.service
After=bookmark-pod.service bookmark-db.service

[Container]
Image=localhost/bookmark-api:latest
ContainerName=bookmark-api

# Load only API env vars from generated prod env file
EnvironmentFile=%h/0_opencode/bookmarkManager/api/.env.api

# Join the pod
Pod=bookmark.pod

# Health check (prod port 11650, driven by API_PORT env var)
HealthCmd=bun run /app/healthcheck.mjs
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s

ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true

[Service]
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=bookmark-pod.service
