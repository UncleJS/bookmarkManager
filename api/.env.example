# Bookmark Manager — environment template
# Copy to ~/bookmark-manager.env and fill in all values.
# This file is loaded by the Quadlet containers (bookmark-db, bookmark-pma, bookmark-api).
# NEVER commit ~/bookmark-manager.env — it contains real credentials.

# Server
API_PORT=11650
LOG_LEVEL=info

# Database — application connection (pod-internal; DB_HOST must be 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bookmark
DB_PASSWORD=your_secure_password
DB_NAME=bookmarks

# MariaDB container init vars (used by mariadb:11 on first start)
MARIADB_DATABASE=bookmarks
MARIADB_USER=bookmark
MARIADB_PASSWORD=your_secure_password
MARIADB_ROOT_PASSWORD=your_root_password

# phpMyAdmin
PMA_HOST=127.0.0.1
PMA_PORT=3306
PMA_ABSOLUTE_URI=http://localhost:11651/
