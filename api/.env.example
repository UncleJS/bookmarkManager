# Bookmark Manager — environment template
# Copy to api/.env and fill in all values.
# scripts/install.sh generates api/.env.api, api/.env.db, and api/.env.pma
# from this file so each container only receives the variables it needs.
# NEVER commit api/.env or the generated split env files — they contain credentials.

# Server
API_PORT=11650
LOG_LEVEL=info

# Database — application connection (pod-internal; DB_HOST must be 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bookmark
DB_PASSWORD=your_secure_password
DB_NAME=bookmarks

# MariaDB container init vars (used by mariadb:11 on first start)
MARIADB_DATABASE=bookmarks
MARIADB_USER=bookmark
MARIADB_PASSWORD=your_secure_password
MARIADB_ROOT_PASSWORD=your_root_password

# phpMyAdmin
PMA_HOST=127.0.0.1
PMA_PORT=3306
PMA_ABSOLUTE_URI=http://localhost:11651/

# Backup — token required to download a DB dump via GET /backup
# Sent as a Bearer token in the Authorization header:
#   Authorization: Bearer <BACKUP_TOKEN>
# Change this to a strong random value before use. The default is intentionally
# refused by the API so you are forced to set a real token.
BACKUP_TOKEN=change_me_please
