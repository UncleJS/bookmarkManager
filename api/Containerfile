# =============================================================================
# Bookmark Manager API — container image (Bun)
#
# Targets:
#   runtime (default, last stage) — production image, production deps only
#   test                          — all deps + source, runs `bun test`
#
# scripts/build.sh passes BUN_IMAGE and INSTANCE. The LABELs sit right after
# each FROM so every intermediate layer carries them and uninstall.sh can find
# and prune the build cache by label.
# =============================================================================
ARG BUN_IMAGE=docker.io/oven/bun:1.4

# ---- base: OS packages, app user, deps manifest -----------------------------
FROM ${BUN_IMAGE} AS base
ARG INSTANCE=bookmark
LABEL app=bookmark-manager \
      bookmark-manager.instance=${INSTANCE}

RUN apt-get update && apt-get install -y --no-install-recommends mariadb-client && rm -rf /var/lib/apt/lists/*
RUN groupadd --system app && useradd --system --gid app --create-home --home-dir /app app

WORKDIR /app
COPY package.json bun.lock ./

# ---- test: all deps + full source, runs the test suite ----------------------
FROM base AS test
ARG INSTANCE=bookmark
LABEL app=bookmark-manager \
      bookmark-manager.instance=${INSTANCE} \
      bookmark-manager.role=test
RUN bun install --frozen-lockfile
COPY src/ ./src/
COPY bunfig.toml tsconfig.json healthcheck.mjs entrypoint.sh ./
RUN chown -R app:app /app
USER app
CMD ["bun", "test", "src/tests"]

# ---- runtime: production deps only (default target) -------------------------
FROM base AS runtime
ARG INSTANCE=bookmark
LABEL app=bookmark-manager \
      bookmark-manager.instance=${INSTANCE}
RUN bun install --frozen-lockfile --production

COPY src/ ./src/
COPY tsconfig.json healthcheck.mjs entrypoint.sh ./

RUN chmod 755 entrypoint.sh && chown -R app:app /app

USER app

EXPOSE 11650

# Migrate, then replace the shell so Bun is PID 1
CMD ["./entrypoint.sh"]
