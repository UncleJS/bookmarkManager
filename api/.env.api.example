# Bookmark Manager — API environment template
# Generated runtime file: api/.env.api
# Copy values into api/.env, then run ./scripts/install.sh to regenerate.

# Server
API_PORT=11650
LOG_LEVEL=info

# Database — application connection (pod-internal; DB_HOST must be 127.0.0.1)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bookmark
DB_PASSWORD=your_secure_password
DB_NAME=bookmarks

# API authentication — token required for all bookmark-management routes
# Sent as a Bearer token in the Authorization header:
#   Authorization: Bearer <API_TOKEN>
# Change this to a strong random value before use. The default is intentionally
# refused by the API so you are forced to set a real token.
# Generate a token: openssl rand -hex 32
API_TOKEN=change_me_please

# Browser UI sessions (optional). The UI login form exchanges API_TOKEN for a
# random session id cookie. Sessions are kept in memory and end on restart.
# SESSION_TTL_HOURS=168
# Extra origins allowed to send cookie-authenticated writes (reverse proxy host names):
# ALLOWED_ORIGINS=https://bookmarks.example.com
# Secure cookie flag: auto (https or X-Forwarded-Proto: https), true or false
# COOKIE_SECURE=auto

# Backup — token required to download a DB dump via GET /backup
# Sent as a Bearer token in the Authorization header:
#   Authorization: Bearer <BACKUP_TOKEN>
# Change this to a strong random value before use. The default is intentionally
# refused by the API so you are forced to set a real token.
BACKUP_TOKEN=change_me_please
