# Server (dev ports: API=11660, phpMyAdmin=11661; prod uses 11650/11651)
API_PORT=11660
LOG_LEVEL=info

# Database — application connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bookmark
DB_PASSWORD=change_me
DB_NAME=bookmarks

# MariaDB container init vars (used by the mariadb:11 image)
MARIADB_DATABASE=bookmarks
MARIADB_USER=bookmark
MARIADB_PASSWORD=change_me
MARIADB_ROOT_PASSWORD=change_me_root

# phpMyAdmin (dev: 11661, prod: 11651)
PMA_HOST=127.0.0.1
PMA_PORT=3306
PMA_ABSOLUTE_URI=http://localhost:11661/
